generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYEE
  SUPERVISOR
  HOD
  FINANCE_DIRECTOR
  GENERAL_MANAGER
  SYSTEM_ADMINISTRATOR
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  SIGNED_HOD
  SIGNED_FINANCE
  SIGNED_GM
  PUBLISHED
  REJECTED
  ARCHIVED
  NEEDS_REVIEW
}

enum DocumentCategory {
  POLICIES
  SOP
  FORMS
  CHECKLISTS
  TEMPLATES
  REPORTS
  CONTRACTS
  TRAINING_MATERIALS
  ARCHIVE
}

enum DocumentPriority {
  HIGH
  MEDIUM
  LOW
}

enum AuditAction {
  LOGIN
  LOGOUT
  VIEW
  DOWNLOAD
  PRINT
  CREATE
  UPDATE
  DELETE
  SIGN
  PUBLISH
  UNPUBLISH
  ARCHIVE
  APPROVE
  REJECT
  SUBMIT
}

enum ConversationType {
  DIRECT
  DEPARTMENT
  HOTEL
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkforceRequestStatus {
  PENDING
  AWAITING_EXTRA_APPROVAL
  APPROVED
  RETURNED_FOR_REVISION
  PROCUREMENT_REVIEW
  PROCUREMENT_CONFIRMED
  REJECTED
  SENT_TO_VENDOR
  VENDOR_ACCEPTED
  VENDORS_FULLY_APPROVED
  IN_SERVICE
  AWAITING_EVALUATION
  VENDOR_DECLINED
  COMPLETED
  CANCELLED
}

enum WorkforceEvaluationPhase {
  ONGOING
  FINAL
}

enum WorkforceVendorMode {
  DIRECT
  BROADCAST
}

enum WorkforceShift {
  MORNING
  EVENING
  NIGHT
  CUSTOM
}

model Department {
  id            String         @id @default(uuid())
  name          String         @unique
  code          String         @unique
  color         String         @default("#294660")
  location      String         @default("Main Hotel")
  description   String?
  createdAt     DateTime       @default(now())
  users         User[]
  documents     Document[]
  templates     Template[]
  conversations Conversation[]
  workforceRequests       WorkforceRequest[]
  workforceApprovalRoute  WorkforceApprovalRoute?
  casualBudgets           DepartmentCasualBudget[]
  workforceTemplates      WorkforceRequestTemplate[]
  workforcePositions      WorkforcePosition[]
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String
  pinHash      String?
  firstName    String
  lastName     String
  role         Role              @default(EMPLOYEE)
  customRoleId String?
  customRole   CustomRole?       @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department?       @relation(fields: [departmentId], references: [id])
  isActive        Boolean           @default(true)
  signatureImage  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  documents    Document[]        @relation("DocumentAuthor")
  ownedDocs    Document[]        @relation("DocumentOwner")
  auditLogs    AuditLog[]
  signatures   Signature[]
  comments                DocumentComment[]
  favorites               UserFavorite[]
  conversationParticipants ConversationParticipant[]
  messages                Message[]
  workforceRequests       WorkforceRequest[]         @relation("WorkforceRequestCreator")
}

enum VendorApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum WorkforceRateUnit {
  HOURLY
  DAILY_9
  DAILY_12
}

model CustomRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  baseRole    Role     @default(EMPLOYEE)
  permissions Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Document {
  id              String              @id @default(uuid())
  title           String
  code            String              @unique
  version         String              @default("1.0")
  description     String?
  content         String?
  status          DocumentStatus      @default(DRAFT)
  category        DocumentCategory
  priority        DocumentPriority    @default(MEDIUM)
  language        String              @default("English")
  tags            String              @default("[]")
  filePath        String?
  fileName        String?
  fileType        String?
  fileSize        Int?
  nextReviewDate  DateTime?
  effectiveDate   DateTime?
  archiveReason   String?
  archivedAt      DateTime?
  archivedBy      String?
  allowDownload   Boolean             @default(true)
  allowComments   Boolean             @default(true)
  departmentId    String
  department      Department          @relation(fields: [departmentId], references: [id])
  authorId        String
  author          User                @relation("DocumentAuthor", fields: [authorId], references: [id])
  ownerId         String?
  owner           User?               @relation("DocumentOwner", fields: [ownerId], references: [id])
  templateId      String?
  template        Template?           @relation(fields: [templateId], references: [id])
  workflowId      String?
  workflow        WorkflowRoute?      @relation(fields: [workflowId], references: [id])
  isLocked            Boolean             @default(false)
  signaturePlacement  String              @default("[]")
  pageCount           Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  history             DocumentHistory[]
  signatures      Signature[]
  versions        DocumentVersion[]
  comments        DocumentComment[]
  attachments     DocumentAttachment[]
  favorites       UserFavorite[]
  attachedInMessages Message[]          @relation("MessageDocument")
  attachedInComments DocumentComment[]  @relation("CommentAttachedDocument")
}

model DocumentVersion {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  version    String
  filePath   String?
  changeNote String?
  createdBy  String
  createdAt  DateTime @default(now())
}

model DocumentHistory {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  action     String
  details    String?
  userId     String?
  userName   String?
  createdAt  DateTime @default(now())
}

model DocumentComment {
  id                 String    @id @default(uuid())
  documentId         String
  document           Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId             String
  user               User      @relation(fields: [userId], references: [id])
  text               String
  attachedDocumentId String?
  attachedDocument   Document? @relation("CommentAttachedDocument", fields: [attachedDocumentId], references: [id], onDelete: SetNull)
  attachmentFileName String?
  attachmentFilePath String?
  attachmentFileSize Int?
  attachmentFileType String?
  status             String    @default("open")
  createdAt          DateTime  @default(now())
}

model DocumentAttachment {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fileName   String
  filePath   String
  fileSize   Int?
  fileType   String?
  createdAt  DateTime @default(now())
}

model Template {
  id           String           @id @default(uuid())
  name         String
  description  String?
  category     DocumentCategory
  content      String?
  version      String           @default("1.0")
  status       String           @default("Active")
  departmentId String?
  department   Department?      @relation(fields: [departmentId], references: [id])
  isActive           Boolean          @default(true)
  signaturePlacement String           @default("[]")
  pageCount          Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  documents          Document[]
}

model WorkflowRoute {
  id          String         @id @default(uuid())
  name        String
  description String?
  steps       String
  isDefault   Boolean        @default(false)
  status      WorkflowStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  documents   Document[]
}

model Signature {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  fullName   String
  position   String
  signedAt   DateTime @default(now())
  ipAddress  String?
  device      String?
  docHash     String?
  imagePath   String?
  placementId String?
  page        Int?
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  userName   String?
  action     AuditAction
  entityType String?
  entityId   String?
  details    String?
  ipAddress  String?
  device     String?
  createdAt  DateTime    @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model SystemSettings {
  id                    String  @id @default("default")
  companyName           String  @default("HOTERRA Hotels & Resorts")
  companyAddress        String  @default("Baku, Azerbaijan")
  timezone              String  @default("Asia/Baku")
  dateFormat            String  @default("DD MMM YYYY")
  timeFormat            String  @default("24h")
  systemLanguage        String  @default("en")
  enableVersioning      Boolean @default(true)
  mandatoryReviewDate   Boolean @default(true)
  requireDescription    Boolean @default(false)
  allowDownload         Boolean @default(true)
  autoLogoutMinutes     Int     @default(30)
  recordsPerPage        Int     @default(20)
  enable2FA             Boolean @default(true)
  allowComments         Boolean @default(true)
  showTooltips          Boolean @default(true)
  defaultStartPage      String  @default("dashboard")
  defaultDocSort        String  @default("updated_desc")
  defaultDocStatus      String  @default("DRAFT")
  notifyEmail           Boolean @default(true)
  notifyPush            Boolean @default(true)
  notifyInApp           Boolean @default(true)
  extendedConfig        String  @default("{}")
}

model UserFavorite {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, documentId])
}

model Conversation {
  id           String                    @id @default(uuid())
  type         ConversationType
  departmentId String?
  department   Department?               @relation(fields: [departmentId], references: [id])
  directKey    String?                   @unique
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  participants ConversationParticipant[]
  messages     Message[]

  @@unique([type, departmentId])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id                 String       @id @default(uuid())
  conversationId     String
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId           String
  sender             User         @relation(fields: [senderId], references: [id])
  content            String
  documentId         String?
  document           Document?    @relation("MessageDocument", fields: [documentId], references: [id], onDelete: SetNull)
  attachmentFileName String?
  attachmentFilePath String?
  attachmentFileSize Int?
  attachmentFileType String?
  createdAt          DateTime     @default(now())
}

model WorkforcePosition {
  id        String             @id @default(uuid())
  name      String             @unique
  departmentId String?
  department Department?       @relation(fields: [departmentId], references: [id])
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  requests  WorkforceRequest[]
  templates WorkforceRequestTemplate[]
  vendorRates VendorServiceRate[]
  requestItems WorkforceRequestItem[]
}

model Vendor {
  id           String             @id @default(uuid())
  name         String             @unique
  contactEmail String?
  phone        String?
  isApproved   Boolean            @default(true)
  approvalStatus VendorApprovalStatus @default(APPROVED)
  approvalSteps  String               @default("[]")
  currentStepIndex Int                @default(0)
  submittedById String?
  submittedAt   DateTime?
  approvedAt    DateTime?
  rejectionReason String?
  replacementRequested Boolean @default(false)
  lowRatingAlertedAt   DateTime?
  insuranceNotes String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  selectedFor  WorkforceRequest[] @relation("SelectedVendor")
  acceptedFor  WorkforceRequest[] @relation("AcceptedVendor")
  invites      VendorInvite[]
  invoices     VendorInvoice[]
  serviceRates VendorServiceRate[]
  approvalEvents VendorApprovalEvent[]
  evaluations WorkforceQualityEvaluation[]
  requestItems WorkforceRequestItem[]
}

model VendorServiceRate {
  id           String            @id @default(uuid())
  vendorId     String
  vendor       Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  positionId   String
  position     WorkforcePosition @relation(fields: [positionId], references: [id])
  unit         WorkforceRateUnit
  price        Float
  currency     String            @default("AZN")
  uom          String            @default("Each")
  requirements String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  requests     WorkforceRequest[]
  requestItems WorkforceRequestItem[]

  @@unique([vendorId, positionId, unit])
}

model VendorApprovalEvent {
  id        String   @id @default(uuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  action    String
  stepIndex Int?
  role      Role?
  userId    String?
  userName  String?
  comment   String?
  signedAt  DateTime @default(now())
}

model WorkforceApprovalRoute {
  id           String     @id @default(uuid())
  departmentId String     @unique
  department   Department @relation(fields: [departmentId], references: [id])
  name         String
  steps        String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model DepartmentCasualBudget {
  id           String     @id @default(uuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  year         Int
  month        Int
  budgetAmount Float
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, year, month])
}

model WorkforceSettings {
  id                     String  @id @default("default")
  hotelName              String  @default("HOTERRA")
  hotelsJson             String  @default("[\"HOTERRA\"]")
  minLeadHours           Int     @default(24)
  estimatedHourlyRate    Float   @default(15)
  estimatedHoursPerShift Float   @default(8)
  notifyEmail            Boolean @default(true)
  notifyPush             Boolean @default(true)
  payrollTolerancePct    Float   @default(5)
}

model WorkforceRequest {
  id                   String                 @id @default(uuid())
  code                 String                 @unique
  hotelName            String                 @default("HOTERRA")
  departmentId         String
  department           Department             @relation(fields: [departmentId], references: [id])
  positionId           String
  position             WorkforcePosition      @relation(fields: [positionId], references: [id])
  vendorRateId         String?
  vendorRate           VendorServiceRate?      @relation(fields: [vendorRateId], references: [id])
  rateUnit             WorkforceRateUnit?
  unitRate             Float?
  rateCurrency         String?                 @default("AZN")
  workDate             DateTime
  endDate              DateTime
  shift                WorkforceShift         @default(MORNING)
  startTime            String?
  endTime              String?
  quantity             Int
  comment              String?
  vendorMode           WorkforceVendorMode    @default(DIRECT)
  vendorId             String?
  vendor               Vendor?                @relation("SelectedVendor", fields: [vendorId], references: [id])
  acceptedVendorId     String?
  acceptedVendor       Vendor?                @relation("AcceptedVendor", fields: [acceptedVendorId], references: [id])
  broadcastVendorIds   String                 @default("[]")
  status               WorkforceRequestStatus @default(PENDING)
  currentStepIndex     Int                    @default(0)
  approvalSteps        String                 @default("[]")
  needsExtraApproval   Boolean                @default(false)
  isUrgentOverride     Boolean                @default(false)
  estimatedCost        Float?
  createdById          String
  createdBy            User                   @relation("WorkforceRequestCreator", fields: [createdById], references: [id])
  actualQuantity       Int?
  actualHours          Float?
  actualCost           Float?
  hodConfirmedAt       DateTime?
  hodConfirmedById     String?
  financeConfirmedAt   DateTime?
  financeConfirmedById String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  events               WorkforceRequestEvent[]
  invites              VendorInvite[]
  invoices             VendorInvoice[]
  evaluations          WorkforceQualityEvaluation[]
  items                WorkforceRequestItem[]
  vendorCorrectionReviews WorkforceVendorCorrectionReview[]
}

model WorkforceRequestItem {
  id            String             @id @default(uuid())
  requestId     String
  request       WorkforceRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  positionId    String
  position      WorkforcePosition  @relation(fields: [positionId], references: [id])
  rateUnit      WorkforceRateUnit
  quantity      Int
  hours         Float?
  vendorRateId  String?
  vendorRate    VendorServiceRate? @relation(fields: [vendorRateId], references: [id])
  vendorId      String?
  vendor        Vendor?            @relation(fields: [vendorId], references: [id])
  unitRate      Float?
  rateCurrency  String?            @default("AZN")
  estimatedCost Float?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  vendorCorrections WorkforceVendorCorrection[]

  @@index([requestId])
  @@index([vendorId])
}

model WorkforceVendorCorrectionReview {
  id                String                       @id @default(uuid())
  requestId         String
  request           WorkforceRequest             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status            String                       @default("DRAFT")
  submittedById     String?
  submittedByName   String?
  submittedAt       DateTime?
  fdApprovedById    String?
  fdApprovedByName  String?
  fdApprovedAt      DateTime?
  fdComment         String?
  gmApprovedById    String?
  gmApprovedByName  String?
  gmApprovedAt      DateTime?
  gmComment         String?
  returnComment     String?
  returnedById      String?
  returnedByName    String?
  returnedAt        DateTime?
  appliedAt         DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  corrections       WorkforceVendorCorrection[]

  @@index([requestId, status])
}

model WorkforceVendorCorrection {
  id                  String                           @id @default(uuid())
  reviewId            String
  review              WorkforceVendorCorrectionReview  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  itemId              String
  item                WorkforceRequestItem             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  originalVendorId    String?
  originalVendorName  String?
  originalRateId      String?
  originalUnitRate    Float?
  originalCost        Float?
  proposedVendorId    String
  proposedVendorName  String
  proposedRateId      String
  proposedUnitRate    Float
  proposedCurrency    String                           @default("AZN")
  proposedCost        Float
  comment             String
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  @@unique([reviewId, itemId])
  @@index([itemId])
}

model WorkforceQualityEvaluation {
  id                     String                   @id @default(uuid())
  requestId              String
  request                WorkforceRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendorId               String
  vendor                 Vendor                   @relation(fields: [vendorId], references: [id])
  phase                   WorkforceEvaluationPhase
  overallScore           Int
  notes                   String?
  replacementRecommended Boolean                  @default(false)
  createdById            String
  createdByName          String
  createdByRole          Role
  createdAt              DateTime                  @default(now())
}

model WorkforceRequestEvent {
  id        String           @id @default(uuid())
  requestId String
  request   WorkforceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action    String
  details   String?
  userId    String?
  userName  String?
  createdAt DateTime         @default(now())
}

model WorkforceRequestTemplate {
  id              String              @id @default(uuid())
  name            String
  departmentId    String?
  department      Department?         @relation(fields: [departmentId], references: [id])
  positionId      String?
  position        WorkforcePosition?  @relation(fields: [positionId], references: [id])
  shift           WorkforceShift      @default(MORNING)
  quantity        Int                 @default(1)
  comment         String?
  dayOfWeek       Int?
  vendorMode      WorkforceVendorMode @default(DIRECT)
  vendorId        String?
  isActive        Boolean             @default(true)
  isRecurring     Boolean             @default(false)
  lastGeneratedAt DateTime?
  hotelName       String?
  createdAt       DateTime            @default(now())
}

model VendorInvite {
  id          String           @id @default(uuid())
  token       String           @unique
  requestId   String
  request     WorkforceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      Vendor           @relation(fields: [vendorId], references: [id])
  status      String           @default("PENDING")
  sentAt      DateTime         @default(now())
  respondedAt DateTime?
  expiresAt   DateTime
}

model VendorInvoice {
  id            String           @id @default(uuid())
  requestId     String
  request       WorkforceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendorId      String
  vendor        Vendor           @relation(fields: [vendorId], references: [id])
  invoiceNumber String
  invoiceHours  Float
  invoiceAmount Float
  invoiceDate   DateTime         @default(now())
  status        String           @default("PENDING")
  matchedAt     DateTime?
  notes         String?
  createdAt     DateTime         @default(now())
}

model EmailOutbox {
  id         String    @id @default(uuid())
  toEmail    String
  subject    String
  body       String
  entityType String?
  entityId   String?
  status     String    @default("QUEUED")
  sentAt     DateTime?
  createdAt  DateTime  @default(now())
}
